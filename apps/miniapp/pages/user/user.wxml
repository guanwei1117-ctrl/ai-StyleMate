<view class="page">
  <!-- 用户信息 -->
  <view class="user-card" wx:if="{{isLoggedIn}}" bindtap="goToProfile">
    <view class="user-avatar">
      <text class="avatar-text">{{userInfo?.nickname?.charAt(0) || 'U'}}</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo?.nickname || '用户'}}</text>
      <text class="user-status" wx:if="{{hasProfile}}">已生成风格档案 ✓</text>
      <text class="user-status" wx:else>尚未测评</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="user-card" wx:else bindtap="goToLogin">
    <view class="user-avatar guest">
      <text class="avatar-text">?</text>
    </view>
    <view class="user-info">
      <text class="user-name">点击登录</text>
      <text class="user-status">登录后可解锁全部功能</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToProfile">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的风格档案</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToOnboarding">
      <text class="menu-icon">🎯</text>
      <text class="menu-text">风格测评</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToStyles">
      <text class="menu-icon">📖</text>
      <text class="menu-text">风格库</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToHistory">
      <text class="menu-icon">📅</text>
      <text class="menu-text">穿搭记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <button class="logout-btn" wx:if="{{isLoggedIn}}" bindtap="handleLogout">退出登录</button>
</view>