.page {
  padding: var(--spacing-lg);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 进度条 */
.progress-bar {
  height: 6rpx;
  background: var(--color-haze-light);
  border-radius: var(--radius-full);
  margin-bottom: var(--spacing-xl);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-olive);
  border-radius: var(--radius-full);
  transition: width var(--transition-normal);
}

/* 步骤标题 */
.step-header {
  margin-bottom: var(--spacing-xl);
}

.step-title {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.step-subtitle {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* 步骤内容 */
.step-content {
  flex: 1;
  overflow: hidden;
}

.form-scroll, .style-scroll {
  height: 100%;
}

.form-group {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-md);
}

.form-hint {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  display: block;
  margin-bottom: var(--spacing-md);
}

.form-input {
  background: var(--color-creme-light);
  border: 2rpx solid var(--color-haze);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  width: 100%;
}

/* 选项按钮 */
.option-row {
  display: flex;
  gap: var(--spacing-md);
}

.option-row.wrap {
  flex-wrap: wrap;
}

.option-btn {
  background: var(--color-creme-light);
  border: 2rpx solid var(--color-haze);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-md);
  color: var(--text-primary);
  text-align: center;
  flex: 1;
}

.option-btn.small {
  flex: none;
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
}

.option-btn.active {
  background: var(--color-olive);
  border-color: var(--color-olive);
  color: var(--text-on-dark);
}

/* 选项卡片 */
.option-card {
  background: var(--color-creme-light);
  border: 2rpx solid var(--color-haze);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.option-card.active {
  border-color: var(--color-olive);
  background: rgba(107, 143, 113, 0.08);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.card-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* 风格网格 */
.style-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
  padding-bottom: var(--spacing-3xl);
}

.style-option {
  background: var(--color-creme-light);
  border: 2rpx solid var(--color-haze);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
}

.style-option.active {
  border-color: var(--color-olive);
  background: rgba(107, 143, 113, 0.08);
}

.style-name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.style-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
  display: block;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 完成页 */
.complete-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 50vh;
}

.complete-icon {
  font-size: 96rpx;
  margin-bottom: var(--spacing-lg);
}

.complete-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
}

.complete-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

/* 底部导航 */
.nav-bar {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-lg) 0;
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
}

.nav-spacer {
  flex: 1;
}

.nav-btn {
  flex: 1;
  padding: var(--spacing-md) 0;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 500;
}

.nav-btn.prev {
  background: var(--color-creme-dark);
  color: var(--text-primary);
}

.nav-btn.next {
  background: var(--color-olive);
  color: var(--text-on-dark);
}

.nav-btn.next[disabled] {
  opacity: 0.7;
}