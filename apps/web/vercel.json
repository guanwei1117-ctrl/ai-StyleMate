{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npx turbo build --filter=@stylemate/web",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && npm install --include-workspace-root",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web/ packages/shared/",
  "github": {
    "silent": true
  }
}