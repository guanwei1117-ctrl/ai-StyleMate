# 强制 shell 脚本和配置文件使用 LF（避免 Windows CRLF 在 Linux 服务器运行报错）
*.sh           text eol=lf
*.bash         text eol=lf
*.env          text eol=lf
*.env.example  text eol=lf
*.conf         text eol=lf
*.nginx        text eol=lf

# Docker / 容器相关
Dockerfile     text eol=lf
docker-compose*.yml  text eol=lf

# 文档和配置文件
*.md           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.toml         text eol=lf
*.json         text eol=lf
*.js           text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf

# Windows 专属（保留 CRLF，方便 PowerShell 阅读）
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf
