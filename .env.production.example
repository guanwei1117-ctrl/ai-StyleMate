# ==========================================
# StyleMate 生产环境变量模板（部署到服务器用）
# 复制为 services/api/.env.production 或项目根 .env
# ==========================================

# --- 数据库（服务器上的 PostgreSQL） ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=stylemate
DB_PASSWORD=改成强密码
DB_NAME=stylemate

# --- Redis（服务器上的 Redis） ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- JWT（必须改！） ---
JWT_SECRET=生成一串足够长的随机字符串
JWT_EXPIRES_IN=7d

# --- AI API（至少配一个） ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=sk-xxx
DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=

# --- 淘宝客联盟（可选，不配则导购走搜索深链模式） ---
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET=
# TAOBAO_ADZONE_ID=

# --- 应用 ---
NODE_ENV=production
PORT=4000
